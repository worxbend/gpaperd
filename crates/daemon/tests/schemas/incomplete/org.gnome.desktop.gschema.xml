<?xml version="1.0" encoding="UTF-8"?>
<!--
  A background schema without picture-options. No GNOME release shipped
  this; reading the missing key would abort the process.
-->
<schemalist>
  <schema id="org.gnome.desktop.background" path="/org/gnome/desktop/background/">
    <key name="picture-uri" type="s">
      <default>'file:///schema-default/light.png'</default>
    </key>
  </schema>
</schemalist>
